# Copy this file to .env and replace the placeholder with your Groq API key.
GROQ_API_KEY=your_groq_api_key_here
# Optional; if omitted, the code selects an available Groq text model.
# GROQ_MODEL=openai/gpt-oss-20b
# Keep each request small enough for free-tier token-per-minute limits.
EVIDENCE_MAX_UNITS=4
EVIDENCE_MAX_OUTPUT_TOKENS=600
EVIDENCE_RESPONSE_RETRIES=2
ASSESSMENT_MAX_OUTPUT_TOKENS=450
PROVIDER_REQUEST_TIMEOUT=30
# Optional OpenRouter fallback used only when Groq is rate-limited.
# One OpenRouter key can access both models.
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_KIMI_MODEL=moonshotai/kimi-k2.5
# OPENROUTER_GEMINI_MODEL=google/gemini-3-flash-preview
# Set free-model order explicitly to fall through when a shared pool is busy.
# OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
# Set true to skip Groq completely and use only OpenRouter.
# OPENROUTER_ONLY=true
